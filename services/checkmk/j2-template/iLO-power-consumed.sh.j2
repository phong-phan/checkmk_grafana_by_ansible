#!/bin/bash
# GET ILO POWER USAGE
source {{ local_check_remote_dir }}/checkmk_creds
hosts='
{% for server in ilo_servers %}
{{ server }}
{% endfor %}
'
# Clean previous content:
truncate -s 0 {{ cmk_csv_remote_dir }}/iLO_power.csv
echo "Host,Watts" > {{ cmk_csv_remote_dir }}/iLO_power.csv

# Loop over list of iLO hosts
for host in $hosts; do
    watts=$(curl -s -k -u $ILO_SVC_USER:$ILO_SVC_PASS https://$host/redfish/v1/Chassis/1/Power/ | jq -r '.PowerControl[0].PowerConsumedWatts')
    echo "$host,$watts" >> {{ cmk_csv_remote_dir }}/iLO_power.csv
done
